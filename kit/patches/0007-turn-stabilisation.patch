+/* Sub-pixel stabilisation while the camera turns.
+ *
+ * VDP1 takes whole-pixel corners and the game rounds every corner on its own,
+ * so between game frames corners kick by about a pixel relative to their
+ * neighbours: distant blocks visibly shake and their seams open and close,
+ * and upscaling multiplies it. While the camera only turns, every static
+ * corner moves from one game frame to the next by one shared homography, which
+ * fits the game's corners to within that rounding. Fitting it over all matched
+ * corners averages the rounding away, so each corner can follow a smooth
+ * sub-pixel path: it starts where its path ended last game frame and ends at
+ * the homography's image of that start, pulled slightly toward the game's own
+ * corner and never more than a pixel from it, so nothing drifts. Corners that
+ * coincide go through the same mapping and stay together. When the fit is not
+ * within rounding (walking, animation, cuts) nothing is changed. */
+static inline int geometry_homography_fit(const float *src,const float *dst,unsigned n,double *H) {
+    /* Normalised least squares with h33 = 1. */
+    double sm[2]={0,0},dm[2]={0,0},ss=0,ds=0;
+    if(n<8)return 0;
+    for(unsigned i=0;i<n;i++){sm[0]+=src[i*2];sm[1]+=src[i*2+1];dm[0]+=dst[i*2];dm[1]+=dst[i*2+1];}
+    sm[0]/=n;sm[1]/=n;dm[0]/=n;dm[1]/=n;
+    for(unsigned i=0;i<n;i++) {
+        ss+=sqrt((src[i*2]-sm[0])*(src[i*2]-sm[0])+(src[i*2+1]-sm[1])*(src[i*2+1]-sm[1]));
+        ds+=sqrt((dst[i*2]-dm[0])*(dst[i*2]-dm[0])+(dst[i*2+1]-dm[1])*(dst[i*2+1]-dm[1]));
+    }
+    if(ss<1e-6||ds<1e-6)return 0;
+    ss=1.4142135623730951*n/ss;ds=1.4142135623730951*n/ds;
+    double A[8][9];memset(A,0,sizeof A);
+    for(unsigned i=0;i<n;i++) {
+        double x=(src[i*2]-sm[0])*ss,y=(src[i*2+1]-sm[1])*ss,u=(dst[i*2]-dm[0])*ds,v=(dst[i*2+1]-dm[1])*ds;
+        double r1[9]={x,y,1,0,0,0,-u*x,-u*y,u},r2[9]={0,0,0,x,y,1,-v*x,-v*y,v};
+        for(unsigned a=0;a<8;a++)for(unsigned b=0;b<9;b++)A[a][b]+=r1[a]*r1[b]+r2[a]*r2[b];
+    }
+    for(unsigned c=0;c<8;c++) {   /* Gaussian elimination with partial pivoting */
+        unsigned p=c;
+        for(unsigned r=c+1;r<8;r++)if(fabs(A[r][c])>fabs(A[p][c]))p=r;
+        if(fabs(A[p][c])<1e-12)return 0;
+        if(p!=c)for(unsigned b=0;b<9;b++){double t=A[c][b];A[c][b]=A[p][b];A[p][b]=t;}
+        for(unsigned r=0;r<8;r++)if(r!=c) {
+            double f=A[r][c]/A[c][c];
+            for(unsigned b=c;b<9;b++)A[r][b]-=f*A[c][b];
+        }
+    }
+    double h[9];for(unsigned c=0;c<8;c++)h[c]=A[c][8]/A[c][c];h[8]=1;
+    /* H = Td^-1 * Hn * Ts */
+    double Ts[9]={ss,0,-ss*sm[0],0,ss,-ss*sm[1],0,0,1},Ti[9]={1/ds,0,dm[0],0,1/ds,dm[1],0,0,1},M[9];
+    for(unsigned a=0;a<3;a++)for(unsigned b=0;b<3;b++){M[a*3+b]=0;for(unsigned k=0;k<3;k++)M[a*3+b]+=h[a*3+k]*Ts[k*3+b];}
+    for(unsigned a=0;a<3;a++)for(unsigned b=0;b<3;b++){H[a*3+b]=0;for(unsigned k=0;k<3;k++)H[a*3+b]+=Ti[a*3+k]*M[k*3+b];}
+    return 1;
+}
+static inline int geometry_homography_apply(const double *H,double x,double y,float *ox,float *oy) {
+    double w=H[6]*x+H[7]*y+H[8];
+    if(fabs(w)<1e-9)return 0;
+    *ox=(float)((H[0]*x+H[1]*y+H[2])/w);*oy=(float)((H[3]*x+H[4]*y+H[5])/w);
+    return isfinite(*ox)&&isfinite(*oy);
+}
+/* Previous game frame's corner paths, keyed by the game's integer corner. */
+typedef struct {int32_t x,y;float sx,sy;uint32_t stamp;} geometry_track_slot;
+typedef struct {geometry_track_slot *slot;unsigned size;uint32_t stamp;} geometry_track;
+static inline geometry_track_slot *geometry_track_find(geometry_track *t,int32_t x,int32_t y,int insert) {
+    if(!t->slot)return NULL;
+    uint32_t h=((uint32_t)x*73856093u)^((uint32_t)y*19349663u);
+    for(unsigned n=0,i=h&(t->size-1);n<t->size;n++,i=(i+1)&(t->size-1)) {
+        geometry_track_slot *s=&t->slot[i];
+        if(s->stamp!=t->stamp){if(!insert)return NULL;s->x=x;s->y=y;s->stamp=t->stamp;return s;}
+        if(s->x==x&&s->y==y)return s;
+    }
+    return NULL;
+}
+/* blend holds each face's previous corners (FLOAT when matched); cur its
+ * current integer corners. On success blend receives the smoothed start
+ * corners, end the smoothed end corners (8 floats per face), and prev is
+ * replaced by this frame's paths. Returns 1 when stabilisation applies. */
+static inline int geometry_stabilize(const saturn_vk_vdp1_op *cur,unsigned n,saturn_vk_vdp1_op *blend,
+    float *end,geometry_track *prev,geometry_track *next) {
+    unsigned m=0,used=0,inliers=0;
+    float *src=malloc((size_t)n*8*sizeof *src),*dst=malloc((size_t)n*8*sizeof *dst);
+    uint8_t *keep=malloc((size_t)n*4+1),*face_ok=calloc(n+1,1);
+    double H[9],motion=0;
+    int ok=0;
+    next->stamp++;
+    if(!src||!dst||!keep||!face_ok)goto done;
+    /* Fit only on corners with a real (integer) previous position; histories
+     * synthesized for new faces are estimates and would bias the fit. */
+    for(unsigned i=0;i<n;i++)if(geometry_eligible(&cur[i])&&(blend[i].flip&SATURN_GEOMETRY_FLOAT)) {
+        int real=1;
+        for(unsigned k=0;k<8;k++){float v=geometry_xy(&blend[i],k);if(v!=floorf(v))real=0;}
+        if(!real)continue;
+        for(unsigned k=0;k<4;k++) {
+            src[m*2]=geometry_xy(&blend[i],k*2);src[m*2+1]=geometry_xy(&blend[i],k*2+1);
+            dst[m*2]=(float)cur[i].xy[k*2];dst[m*2+1]=(float)cur[i].xy[k*2+1];
+            motion+=fabs(dst[m*2]-src[m*2])+fabs(dst[m*2+1]-src[m*2+1]);m++;
+        }
+    }
+    if(m<24 || motion/m<1.0)goto done;
+    /* Robust fit: refit on the corners that agree until the set settles. */
+    for(unsigned i=0;i<m;i++)keep[i]=1;
+    for(unsigned round=0;round<4;round++) {
+        unsigned k=0;
+        float *s2=malloc((size_t)m*2*sizeof *s2),*d2=malloc((size_t)m*2*sizeof *d2);
+        if(!s2||!d2){free(s2);free(d2);goto done;}
+        for(unsigned i=0;i<m;i++)if(keep[i]){s2[k*2]=src[i*2];s2[k*2+1]=src[i*2+1];d2[k*2]=dst[i*2];d2[k*2+1]=dst[i*2+1];k++;}
+        int fitted=k>=24&&geometry_homography_fit(s2,d2,k,H);
+        free(s2);free(d2);
+        if(!fitted)goto done;
+        unsigned changed=0;inliers=0;
+        for(unsigned i=0;i<m;i++) {
+            float x,y;
+            int in=geometry_homography_apply(H,src[i*2],src[i*2+1],&x,&y)&&
+                   fabs(x-dst[i*2])<=1.6&&fabs(y-dst[i*2+1])<=1.6;
+            if(in!=keep[i]){keep[i]=(uint8_t)in;changed++;}
+            inliers+=in;
+        }
+        if(!changed)break;
+    }
+    if(inliers*5<m*4)goto done;   /* not one rigid view change */
+    /* A face is stabilised when every corner follows the fit. */
+    for(unsigned i=0;i<n;i++)if(geometry_eligible(&cur[i])&&(blend[i].flip&SATURN_GEOMETRY_FLOAT)) {
+        int all=1;
+        for(unsigned k=0;k<4&&all;k++) {
+            float x,y;
+            all=geometry_homography_apply(H,geometry_xy(&blend[i],k*2),geometry_xy(&blend[i],k*2+1),&x,&y)&&
+                fabs(x-(float)cur[i].xy[k*2])<=1.6f&&fabs(y-(float)cur[i].xy[k*2+1])<=1.6f;
+        }
+        face_ok[i]=(uint8_t)all;
+    }
+    for(unsigned i=0;i<n;i++) {
+        for(unsigned k=0;k<8;k++)end[i*8+k]=(float)cur[i].xy[k];
+        if(!face_ok[i])continue;
+        for(unsigned k=0;k<4;k++) {
+            float ox=geometry_xy(&blend[i],k*2),oy=geometry_xy(&blend[i],k*2+1),sx=ox,sy=oy,ex,ey;
+            /* where this corner's smoothed path ended last game frame */
+            if(ox==floorf(ox)&&oy==floorf(oy)) {
+                geometry_track_slot *p=geometry_track_find(prev,(int32_t)ox,(int32_t)oy,0);
+                if(p){sx=p->sx;sy=p->sy;}
+            }
+            float cx=(float)cur[i].xy[k*2],cy=(float)cur[i].xy[k*2+1];
+            if(!geometry_homography_apply(H,sx,sy,&ex,&ey)){ex=cx;ey=cy;}
+            ex=cx+(ex-cx)*0.85f;ey=cy+(ey-cy)*0.85f;
+            ex=fminf(fmaxf(ex,cx-1.0f),cx+1.0f);ey=fminf(fmaxf(ey,cy-1.0f),cy+1.0f);
+            memcpy(&blend[i].xy[k*2],&sx,4);memcpy(&blend[i].xy[k*2+1],&sy,4);
+            end[i*8+k*2]=ex;end[i*8+k*2+1]=ey;
+            geometry_track_slot *q=geometry_track_find(next,cur[i].xy[k*2],cur[i].xy[k*2+1],1);
+            if(q){q->sx=ex;q->sy=ey;}
+        }
+        used++;
+    }
+    ok=used>0;
+done:
+    free(src);free(dst);free(keep);free(face_ok);
+    return ok;
+}
