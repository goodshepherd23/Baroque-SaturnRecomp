+/* A wall of 8x4 tiles (one texture per column, so matching is unambiguous)
+ * seen by a turning perspective camera and rounded to whole pixels each game
+ * frame like VDP1. The stabilised corners must sit closer to the true
+ * projection than the rounded ones, never more than a pixel from the rounded
+ * ones, and a still picture must be left alone. */
+static void turn_wall(double yaw,saturn_vk_vdp1_op *ops,double *truth) {
+    for(unsigned t=0;t<32;t++) {
+        ops[t]=quad(0,7+t%8);
+        for(unsigned k=0;k<4;k++) {
+            double wx=(double)(t%8)+(k==1||k==2)-4.0,wy=(double)(t/8)+(k>=2)-2.0,wz=6.0;
+            double cx=wx*cos(yaw)-wz*sin(yaw),cz=wx*sin(yaw)+wz*cos(yaw);
+            truth[t*8+k*2]=176.0+160.0*cx/cz;truth[t*8+k*2+1]=112.0+160.0*wy/cz;
+            ops[t].xy[k*2]=(int32_t)lround(truth[t*8+k*2]);ops[t].xy[k*2+1]=(int32_t)lround(truth[t*8+k*2+1]);
+        }
+    }
+}
+static int turn_stabilisation(void) {
+    enum {N=32,F=12};
+    static saturn_vk_vdp1_op ops[F][N],blend[N];
+    static double truth[F][N*8];
+    static float end[N*8];
+    static geometry_track_slot slots[2][4096];
+    geometry_track track[2]={{slots[0],4096,1},{slots[1],4096,1}};
+    unsigned prev=0;
+    double raw=0,smooth=0;
+    for(unsigned f=0;f<F;f++)turn_wall(0.05*f,ops[f],truth[f]);
+    for(unsigned f=1;f<F;f++) {
+        geometry_interpolate(ops[f-1],N,ops[f],N,0,blend);geometry_weld(ops[f],N,blend);
+        CHECK(geometry_stabilize(ops[f],N,blend,end,&track[prev],&track[prev^1u]));
+        prev^=1u;
+        for(unsigned i=0;i<N*8;i++) {
+            CHECK(fabsf(end[i]-(float)ops[f][i/8].xy[i%8])<=1.0f);
+            if(f>=3){raw+=fabs(ops[f][i/8].xy[i%8]-truth[f][i]);smooth+=fabs(end[i]-truth[f][i]);}
+        }
+    }
+    CHECK(smooth<raw*0.8);
+    /* still: no motion, nothing to stabilise */
+    geometry_interpolate(ops[0],N,ops[0],N,0,blend);
+    CHECK(!geometry_stabilize(ops[0],N,blend,end,&track[prev],&track[prev^1u]));
+    return 0;
+}
