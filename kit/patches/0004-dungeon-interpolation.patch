+/* Two different faces whose histories agree on the edge are an ordinary seam.
+ * Three or more stay ambiguous when any two of them are the same polygon
+ * drawn twice (stacked faces cannot tell their histories apart), but distinct
+ * faces meeting along one screen edge are real geometry: Baroque's ceiling
+ * trim meets the wall panels above and below it, and holding those froze the
+ * whole connected room. `shape` is the picture the edges were taken from. */
+static inline int geometry_same_shape(const saturn_vk_vdp1_op *a,const saturn_vk_vdp1_op *b) {
+    for(unsigned k=0;k<8;k++)if(geometry_xy(a,k)!=geometry_xy(b,k))return 0;
+    return 1;
+}
+static inline int geometry_edge_group_ok(const saturn_vk_vdp1_op *shape,const saturn_vk_vdp1_op *other,
+    const geometry_edge *e,unsigned begin,unsigned end,float limit) {
+    for(unsigned j=begin+1;j<end;j++) {
+        for(unsigned k=begin;k<j;k++) {
+            if(e[k].face==e[j].face)return 0;
+            if(end-begin>2 && geometry_same_shape(&shape[e[k].face],&shape[e[j].face]))return 0;
