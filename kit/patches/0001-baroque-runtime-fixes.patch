+/* Internal backup RAM persistence. saturn_init formats a fresh BUP on every
+ * boot, so a game's saves vanished when the window closed. The image lives
+ * in backup.bin beside the game's declaration (SATURN_BUPFILE overrides).
+ * Writes are debounced: a BUP library updates several blocks across a few
+ * fields, so the file is written once the contents have changed and then
+ * held still for one check interval, and again at shutdown. Only a frontend
+ * that called bup_persist_load persists anything. */
+static int     bup_enabled;
+static int     bup_pending;
+static uint8_t bup_shadow[BUP_SIZE];
+static char    bup_path[512];
+
+static void bup_write(saturn *s)
+{
+    char tmp[530];
+    FILE *f;
+    snprintf(tmp, sizeof tmp, "%s.tmp", bup_path);
+    f = fopen(tmp, "wb");
+    if (!f) return;
+    if (fwrite(s->bup, 1, BUP_SIZE, f) != BUP_SIZE) { fclose(f); remove(tmp); return; }
+    if (fclose(f) != 0) { remove(tmp); return; }
+#ifdef _WIN32
+    MoveFileExA(tmp, bup_path, MOVEFILE_REPLACE_EXISTING);
+#else
+    rename(tmp, bup_path);
+#endif
+}
+
+void bup_persist_load(saturn *s)
+{
+    const char *e = getenv("SATURN_BUPFILE");
+    FILE *f;
+    if (e && *e) {
+        snprintf(bup_path, sizeof bup_path, "%s", e);
+    } else {
+        /* smpc_state_path is "<game dir>/smpc.bin" or bare "smpc.bin". */
+        const char *sp = s->smpc_state_path;
+        const char *slash = strrchr(sp, '/'), *bslash = strrchr(sp, '\\');
+        const char *cut = slash > bslash ? slash : bslash;
+        size_t dirlen = cut ? (size_t)(cut - sp) + 1 : 0;
+        if (dirlen >= sizeof bup_path - 16) dirlen = 0;
+        memcpy(bup_path, sp, dirlen);
+        strcpy(bup_path + dirlen, "backup.bin");
+    }
+    f = fopen(bup_path, "rb");
+    if (f) {
+        static uint8_t buf[BUP_SIZE];
+        if (fread(buf, 1, BUP_SIZE, f) == BUP_SIZE) memcpy(s->bup, buf, BUP_SIZE);
+        fclose(f);
+    }
+    memcpy(bup_shadow, s->bup, BUP_SIZE);
+    bup_pending = 0;
+    bup_enabled = 1;
+}
+
+void bup_persist_tick(saturn *s)
+{
+    if (!bup_enabled || s->frames % 30u) return;
+    if (memcmp(bup_shadow, s->bup, BUP_SIZE) != 0) {
+        memcpy(bup_shadow, s->bup, BUP_SIZE);
+        bup_pending = 1;
+    } else if (bup_pending) {
+        bup_write(s);
+        bup_pending = 0;
+    }
+}
+
+void bup_persist_flush(saturn *s)
+{
+    if (!bup_enabled) return;
+    if (bup_pending || memcmp(bup_shadow, s->bup, BUP_SIZE) != 0) {
+        memcpy(bup_shadow, s->bup, BUP_SIZE);
+        bup_write(s);
+        bup_pending = 0;
+    }
+}
+
+/* Action Replay / GameShark codes. cheats.txt beside the game's declaration
+ * (SATURN_CHEATFILE overrides) holds named groups of codes:
+ *
+ *     + Infinite HP        <- "+" enables the codes below it, "-" disables
+ *     16098D4E FFFF
+ *
+ * Saturn Action Replay types: 1AAAAAAA VVVV writes 16 bits, 3AAAAAAA 00VV
+ * writes 8 bits, DAAAAAAA VVVV runs the next code only if the 16-bit value
+ * at A equals V. F/B master codes install the cartridge's hook; there is no
+ * cartridge here, so they are accepted and skipped. Codes are applied once
+ * per field, like the cartridge's V-Blank hook, as master-CPU writes so the
+ * caches stay coherent; the file is re-read when it changes, so cheats can be
+ * toggled while the game runs. */
+#include <sys/stat.h>
+typedef struct { uint8_t type; uint32_t addr; uint16_t val; } ar_code;
+static ar_code ar_codes[1024];
+static int     ar_count, ar_active;
+static char    ar_path[512];
+static long long ar_stamp = -1;
+
+static long long ar_file_stamp(void)
+{
+    struct stat st;
+    if (stat(ar_path, &st) != 0) return -1;
+    return (long long)st.st_mtime * 1000003LL + (long long)st.st_size;
+}
+
+static void ar_parse(void)
+{
+    char line[512];
+    int on = 0, groups = 0, skipped = 0;
+    FILE *f = fopen(ar_path, "r");
+    ar_count = 0;
+    if (!f) return;
+    while (fgets(line, sizeof line, f)) {
+        char *p = line;
+        unsigned long a, v;
+        while (*p == ' ' || *p == '\t') p++;
+        if (*p == '+' || *p == '-') { on = *p == '+'; groups += on; continue; }
+        if (!on || !isxdigit((unsigned char)*p)) continue;
+        for (char *q = p; *q; q++) if (*q == ':') *q = ' ';
+        if (sscanf(p, "%8lx %4lx", &a, &v) != 2) continue;
+        unsigned type = (unsigned)(a >> 28);
+        if (type != 1 && type != 3 && type != 0xD) { skipped += type != 0xF && type != 0xB; continue; }
+        if (ar_count >= (int)(sizeof ar_codes / sizeof *ar_codes)) break;
+        ar_codes[ar_count].type = (uint8_t)type;
+        ar_codes[ar_count].addr = (uint32_t)(a & 0x0FFFFFFFu);
+        ar_codes[ar_count].val  = (uint16_t)v;
+        ar_count++;
+    }
+    fclose(f);
+    fprintf(stderr, "[cheats] %d code(s) active in %d enabled cheat(s)%s\n",
+            ar_count, groups, skipped ? " (unsupported code types skipped)" : "");
+}
+
+void cheats_load(saturn *s)
+{
+    const char *e = getenv("SATURN_CHEATFILE");
+    if (e && *e) {
+        snprintf(ar_path, sizeof ar_path, "%s", e);
+    } else {
+        const char *sp = s->smpc_state_path;
+        const char *slash = strrchr(sp, '/'), *bslash = strrchr(sp, '\\');
+        const char *cut = slash > bslash ? slash : bslash;
+        size_t dirlen = cut ? (size_t)(cut - sp) + 1 : 0;
+        if (dirlen >= sizeof ar_path - 16) dirlen = 0;
+        memcpy(ar_path, sp, dirlen);
+        strcpy(ar_path + dirlen, "cheats.txt");
+    }
+    ar_stamp = ar_file_stamp();
+    ar_parse();
+    ar_active = 1;
+}
+
+static void ar_write(saturn *s, uint32_t a, uint16_t v, unsigned size)
+{
+    sh2 *save = s->cur;
+    s->cur = &s->master;
+    if (size == 1) bus_w8(s, a, (uint8_t)v); else bus_w16(s, a & ~1u, v);
+    s->cur = save;
+    sh2_cache_write(&s->slave, size == 1 ? a : (a & ~1u), v, size);
+}
+
+void cheats_tick(saturn *s)
+{
+    int skip = 0;
+    if (!ar_active) return;
+    if (s->frames % 60u == 0) {
+        long long stamp = ar_file_stamp();
+        if (stamp != ar_stamp) { ar_stamp = stamp; ar_parse(); }
+    }
+    for (int i = 0; i < ar_count; i++) {
+        const ar_code *c = &ar_codes[i];
+        if (skip) { skip = 0; continue; }
+        switch (c->type) {
+        case 0x1: ar_write(s, c->addr, c->val, 2); break;
+        case 0x3: ar_write(s, c->addr, c->val & 0xFFu, 1); break;
+        case 0xD: {
+            sh2 *save = s->cur;
+            s->cur = &s->master;
+            skip = bus_r16(s, c->addr & ~1u) != c->val;
+            s->cur = save;
+            break;
+        }
+        }
+    }
+}
+
 void smpc_reset(saturn *s)
 {
     memset(s->smpc_reg, 0, sizeof(s->smpc_reg));
