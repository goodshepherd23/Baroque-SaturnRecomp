+/* Walking forward down a corridor: a floor and a side wall, each a different
+ * plane, so no single homography fits the picture. Stabilisation must run on
+ * the faces' own flat patches without bias (no further from the true
+ * projection than the whole-pixel corners), stay within a pixel of them, and
+ * keep one shared position for every corner (no crack where the wall meets
+ * the floor). */
+static unsigned corridor(double z0,saturn_vk_vdp1_op *ops,double *truth) {
+    unsigned n=0;
+    for(unsigned plane=0;plane<2;plane++)for(unsigned a=0;a<4;a++)for(unsigned b=0;b<6;b++) {
+        saturn_vk_vdp1_op *o=&ops[n];
+        *o=quad(0,20+plane*40+a*6+b);   /* one texture per tile: unambiguous */
+        for(unsigned k=0;k<4;k++) {
+            double u=(double)a+(k==1||k==2),v=(double)b+(k>=2),x,y,z;
+            if(!plane){x=u-2.0;y=-1.5;z=v+3.0;}       /* floor */
+            else{x=-2.0;y=u*0.75-1.5;z=v+3.0;}        /* left wall */
