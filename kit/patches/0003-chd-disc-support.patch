diff --git a/tools/chdcheck.c b/tools/chdcheck.c
new file mode 100644
index 0000000..dbf3764
--- /dev/null
+++ b/tools/chdcheck.c
@@ -0,0 +1,27 @@
+/* chdcheck <image.chd> <product-no>: exit 0 if the CHD is a Saturn disc with that product number.
+ * Setup uses it to refuse the wrong game before it spends minutes building. */
+#include "disc_chd.h"
+#include <stdio.h>
+#include <string.h>
+
+int main(int argc, char **argv)
+{
+    chd_image *c = NULL;
+    char err[256] = {0};
+    uint8_t buf[64];
+    char product[11] = {0};
+
+    if (argc != 3) { fprintf(stderr, "usage: chdcheck <image.chd> <product-no>\n"); return 2; }
+    if (chd_image_open(argv[1], &c, err, sizeof(err)) != 0) { fprintf(stderr, "That CHD is not a Sega Saturn disc image (%s).\n", err); return 1; }
+    /* First data sector is raw: 16 bytes of sync and header, then the IP.BIN header. */
+    if (chd_image_read(c, 16, buf, sizeof(buf)) != 0) { fprintf(stderr, "That CHD is not a Sega Saturn disc image (its first sector cannot be read).\n"); chd_image_close(c); return 1; }
+    chd_image_close(c);
+    if (memcmp(buf, "SEGA SEGASATURN", 15) != 0) { fprintf(stderr, "That CHD is not a Sega Saturn disc image.\n"); return 1; }
+    memcpy(product, buf + 0x20, 10);
+    for (int i = 9; i >= 0 && (product[i] == ' ' || product[i] == 0); i--) product[i] = 0;
+    if (strncmp(product, argv[2], strlen(argv[2])) != 0) {
+        fprintf(stderr, "That CHD is %s, not Baroque (%s).\n", product, argv[2]);
+        return 1;
+    }
+    return 0;
+}
