diff --git a/recompiler/src/disc_chd.c b/recompiler/src/disc_chd.c
new file mode 100644
index 0000000..b600e21
--- /dev/null
+++ b/recompiler/src/disc_chd.c
@@ -0,0 +1,202 @@
+/* disc_chd.c — see disc_chd.h. */
+#include "disc_chd.h"
+#include <libchdr/chd.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define CHD_UNIT      2448u   /* 2352 sector + 96 subcode */
+#define SECTOR        2352u
+#define TRACK_PAD     4u      /* each track is padded to a multiple of 4 frames in the CHD */
+#define MAX_TRACKS    99
+#define CACHE_HUNKS   4
+
+typedef struct {
+    int      num;
+    int      audio;
+    int      mode2;
+    uint32_t frames;        /* frames the track contributes to the virtual BIN */
+    uint32_t pregap;        /* PREGAP frames */
+    uint32_t vstart;        /* first virtual-BIN frame of the track */
+    uint32_t chd_start;     /* first CHD frame of the track */
+} chd_track;
+
+typedef struct {
+    uint8_t *data;
+    int64_t  hunk;          /* -1 when empty */
+    uint64_t stamp;
+} hunk_slot;
+
+struct chd_image {
+    chd_file  *chd;
+    uint32_t   hunkbytes;
+    uint32_t   frames_per_hunk;
+    chd_track  tracks[MAX_TRACKS];
+    int        ntracks;
+    uint32_t   total_frames;   /* virtual BIN frames */
+    hunk_slot  cache[CACHE_HUNKS];
+    uint64_t   clock;
+};
+
+static void set_err(char *err, size_t n, const char *fmt, const char *a) {
+    if (err && n) snprintf(err, n, fmt, a ? a : "");
+}
+
+static int parse_tracks(chd_image *c, char *err, size_t errn) {
+    uint32_t pad_total = 0, virt_total = 0;
+    for (uint32_t i = 0; i < MAX_TRACKS; i++) {
+        char meta[512], type[32] = {0}, sub[32] = {0}, pgtype[32] = {0}, pgsub[32] = {0};
+        uint32_t len = 0;
+        int trk = 0, frames = 0, pregap = 0, postgap = 0;
+        chd_error e = chd_get_metadata(c->chd, CDROM_TRACK_METADATA2_TAG, i, meta, sizeof(meta) - 1, &len, NULL, NULL);
+        chd_track *t;
+        if (e == CHDERR_NONE) {
+            meta[len < sizeof(meta) ? len : sizeof(meta) - 1] = 0;
+            if (sscanf(meta, "TRACK:%d TYPE:%31s SUBTYPE:%31s FRAMES:%d PREGAP:%d PGTYPE:%31s PGSUB:%31s POSTGAP:%d",
+                       &trk, type, sub, &frames, &pregap, pgtype, pgsub, &postgap) < 5) {
+                set_err(err, errn, "unreadable track metadata in the CHD%s", "");
+                return -1;
+            }
+        } else {
+            e = chd_get_metadata(c->chd, CDROM_TRACK_METADATA_TAG, i, meta, sizeof(meta) - 1, &len, NULL, NULL);
+            if (e != CHDERR_NONE) break;   /* no more tracks */
+            meta[len < sizeof(meta) ? len : sizeof(meta) - 1] = 0;
+            if (sscanf(meta, "TRACK:%d TYPE:%31s SUBTYPE:%31s FRAMES:%d", &trk, type, sub, &frames) < 4) {
+                set_err(err, errn, "unreadable track metadata in the CHD%s", "");
+                return -1;
+            }
+        }
+        if (frames <= 0) { set_err(err, errn, "the CHD has an empty track%s", ""); return -1; }
+        t = &c->tracks[c->ntracks];
+        memset(t, 0, sizeof(*t));
+        t->num    = trk;
+        t->frames = (uint32_t)frames;
+        t->pregap = pregap > 0 ? (uint32_t)pregap : 0;
+        if (strcmp(type, "AUDIO") == 0)           t->audio = 1;
+        else if (strcmp(type, "MODE1_RAW") == 0)  t->mode2 = 0;
+        else if (strcmp(type, "MODE2_RAW") == 0)  t->mode2 = 1;
+        else {
+            set_err(err, errn, "the CHD has a %s track; only raw (2352-byte) CD images are supported", type);
+            return -1;
+        }
+        /* The pregap frames are part of FRAMES: the reference BIN from chdman extractcd stores
+         * them (checked on a real Saturn disc whose PGTYPE reads VAUDIO). */
+        t->vstart    = virt_total;
+        t->chd_start = pad_total;
+        virt_total  += t->frames;
+        pad_total   += (t->frames + TRACK_PAD - 1) / TRACK_PAD * TRACK_PAD;
+        c->ntracks++;
+    }
+    if (!c->ntracks) { set_err(err, errn, "the CHD holds no CD track metadata (is it a CD image?)%s", ""); return -1; }
+    c->total_frames = virt_total;
+    return 0;
+}
+
+int chd_image_open(const char *path, chd_image **out, char *err, size_t errn) {
+    chd_image *c = (chd_image *)calloc(1, sizeof(*c));
+    const chd_header *h;
+    chd_error e;
+    if (!c) { set_err(err, errn, "out of memory%s", ""); return -1; }
+    e = chd_open(path, CHD_OPEN_READ, NULL, &c->chd);
+    if (e != CHDERR_NONE) {
+        set_err(err, errn, "cannot open the CHD: %s", chd_error_string(e));
+        free(c);
+        return -1;
+    }
+    h = chd_get_header(c->chd);
+    if (!h || h->unitbytes != CHD_UNIT || h->hunkbytes == 0 || h->hunkbytes % CHD_UNIT) {
+        set_err(err, errn, "that CHD is not a CD image%s", "");
+        chd_close(c->chd); free(c);
+        return -1;
+    }
+    c->hunkbytes = h->hunkbytes;
+    c->frames_per_hunk = h->hunkbytes / CHD_UNIT;
+    if (parse_tracks(c, err, errn) != 0) { chd_close(c->chd); free(c); return -1; }
+    for (int i = 0; i < CACHE_HUNKS; i++) {
+        c->cache[i].data = (uint8_t *)malloc(c->hunkbytes);
+        c->cache[i].hunk = -1;
+        if (!c->cache[i].data) { chd_image_close(c); set_err(err, errn, "out of memory%s", ""); return -1; }
+    }
+    *out = c;
+    return 0;
+}
+
+void chd_image_close(chd_image *c) {
+    if (!c) return;
+    for (int i = 0; i < CACHE_HUNKS; i++) free(c->cache[i].data);
+    if (c->chd) chd_close(c->chd);
+    free(c);
+}
+
+uint64_t chd_image_size(const chd_image *c) { return (uint64_t)c->total_frames * SECTOR; }
+
+static const uint8_t *get_hunk(chd_image *c, uint32_t hunk) {
+    hunk_slot *victim = &c->cache[0];
+    for (int i = 0; i < CACHE_HUNKS; i++) {
+        if (c->cache[i].hunk == (int64_t)hunk) { c->cache[i].stamp = ++c->clock; return c->cache[i].data; }
+        if (c->cache[i].stamp < victim->stamp) victim = &c->cache[i];
+    }
+    if (chd_read(c->chd, hunk, victim->data) != CHDERR_NONE) { victim->hunk = -1; return NULL; }
+    victim->hunk = (int64_t)hunk;
+    victim->stamp = ++c->clock;
+    return victim->data;
+}
+
+/* One 2352-byte sector of the virtual BIN, as chdman extractcd would write it. */
+static int read_frame(chd_image *c, uint32_t vframe, uint8_t *out) {
+    const chd_track *t = NULL;
+    for (int i = c->ntracks - 1; i >= 0; i--)
+        if (c->tracks[i].vstart <= vframe) { t = &c->tracks[i]; break; }
+    if (!t || vframe >= t->vstart + t->frames) return -1;
+    {
+        uint32_t cf = t->chd_start + (vframe - t->vstart);
+        const uint8_t *hd = get_hunk(c, cf / c->frames_per_hunk);
+        if (!hd) return -1;
+        memcpy(out, hd + (size_t)(cf % c->frames_per_hunk) * CHD_UNIT, SECTOR);
+    }
+    if (t->audio) {   /* the CHD keeps CD audio big-endian; a BIN holds little-endian samples */
+        for (unsigned i = 0; i < SECTOR; i += 2) { uint8_t a = out[i]; out[i] = out[i + 1]; out[i + 1] = a; }
+    }
+    return 0;
+}
+
+int chd_image_read(chd_image *c, uint64_t off, void *buf, size_t n) {
+    uint8_t *o = (uint8_t *)buf;
+    uint8_t sec[SECTOR];
+    if (off + n > chd_image_size(c)) return -1;
+    while (n) {
+        uint32_t frame = (uint32_t)(off / SECTOR);
+        size_t   in    = (size_t)(off % SECTOR);
+        size_t   take  = SECTOR - in < n ? SECTOR - in : n;
+        if (read_frame(c, frame, sec) != 0) return -1;
+        memcpy(o, sec + in, take);
+        o += take; off += take; n -= take;
+    }
+    return 0;
+}
+
+static void msf(char *out, size_t n, uint32_t f) {
+    snprintf(out, n, "%02u:%02u:%02u", f / (60 * 75), (f / 75) % 60, f % 75);
+}
+
+char *chd_image_cue(const chd_image *c, const char *bin_name) {
+    size_t cap = 256 + (size_t)c->ntracks * 160 + strlen(bin_name);
+    char *s = (char *)malloc(cap), *p = s;
+    char a[16], b[16];
+    if (!s) return NULL;
+    p += snprintf(p, cap, "FILE \"%s\" BINARY\n", bin_name);
+    for (int i = 0; i < c->ntracks; i++) {
+        const chd_track *t = &c->tracks[i];
+        uint32_t idx1 = t->vstart;
+        p += snprintf(p, cap - (size_t)(p - s), "  TRACK %02d %s\n", t->num,
+                      t->audio ? "AUDIO" : (t->mode2 ? "MODE2/2352" : "MODE1/2352"));
+        if (t->pregap) {
+            msf(a, sizeof a, t->vstart);
+            p += snprintf(p, cap - (size_t)(p - s), "    INDEX 00 %s\n", a);
+            idx1 += t->pregap;
+        }
+        msf(b, sizeof b, idx1);
+        p += snprintf(p, cap - (size_t)(p - s), "    INDEX 01 %s\n", b);
+    }
+    return s;
+}
