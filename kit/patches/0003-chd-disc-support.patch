+/* disc_chd.h — read a Saturn CD image stored as a MAME .chd (via libchdr).
+ *
+ * The CHD is presented as ONE virtual BIN: every track's 2352-byte sectors in
+ * order, exactly the file `chdman extractcd` would write. disc.c then treats it
+ * like a single-BIN cue (the cue text comes from chd_image_cue()), so track
+ * layout, pregap and sector handling are the code paths cue/bin images already use.
+ */
+#ifndef DISC_CHD_H
+#define DISC_CHD_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+typedef struct chd_image chd_image;
+
+/* Returns 0 on success; on failure fills err. */
+int       chd_image_open(const char *path, chd_image **out, char *err, size_t errn);
+void      chd_image_close(chd_image *c);
+/* Size in bytes of the virtual BIN. */
+uint64_t  chd_image_size(const chd_image *c);
+/* Read n bytes at byte offset off of the virtual BIN. Returns 0 on success. */
+int       chd_image_read(chd_image *c, uint64_t off, void *buf, size_t n);
+/* The cue sheet chdman would write for this image, naming the BIN `bin_name`.
+ * malloc'd; free() it. NULL on failure. */
+char     *chd_image_cue(const chd_image *c, const char *bin_name);
+
+#endif
